#
# Le PLANCHER : la version PUBLIÉE de coprofirst dont le contrat d'API se génère —
# le seul endroit où elle s'écrit. L'app parle à des installations de versions
# différentes : elle se génère sur la plus ANCIENNE servie par une installation
# connue. Monter le plancher est une décision ; on change ces lignes, puis
# `bash scripts/importer-contrat.sh`, dans la même PR.
PLANCHER=v3.108.0
RAISON="contrat 2.4.0 : servi par demo.coprofirst.fr et 5hostachy.fr (v3.108.0), mesuré le 17/11/2026 ; apporte les montres (/montres, jeton de portée « montre », coprofirst#2771) pour Wear OS (#207) et le champ plateforme du push (coprofirst#2789) — décision du coordinateur ; l'iOS garde v3.106.0 pour sa 1.1, les deux se réalignent à la version suivante"

# Les installations CONNUES, dont le contrat servi se mesure chaque jour
# (scripts/concordance.py) : le plancher ne monte jamais au-dessus du plus ancien.
INSTALLATIONS="demo.coprofirst.fr 5hostachy.fr"

# Le LOGO se recopie à part : sa licence ne couvre l'app Android que depuis cette
# version (coprofirst#2743) ; il ne dépend pas du contrat. scripts/importer-logo.sh.
LOGO=v3.101.3
