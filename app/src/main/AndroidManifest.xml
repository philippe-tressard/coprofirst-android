<!-- Un droit neuf se déclare aussi dans la section « Sécurité des données » de Google
     Play (standards/14 §3 bis). INTERNET : lire l'API de la résidence donnée par
     l'utilisateur, rien d'autre. CAMERA (#6) : lire le QR code de la fiche d'arrivée,
     demandée à l'ouverture du scanner seulement ; l'image est lue sur l'appareil, ni
     gardée ni envoyée — rien n'est « collecté » au sens de Google Play. La caméra n'est
     pas exigée : sans elle, l'adresse se saisit. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera.any" android:required="false" />

    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/regles_extraction"
        android:fullBackupContent="@xml/regles_sauvegarde"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/nom_app"
        android:supportsRtl="true"
        android:usesCleartextTraffic="false"
        android:theme="@android:style/Theme.Material.NoActionBar">
        <!-- singleTask : un lien d'application rejoint l'app ouverte (onNewIntent), il n'en
             empile pas une seconde. -->
        <activity
            android:name=".ActiviteAccueil"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Les liens d'application (#7) : les hôtes de l'iOS (associated domains,
                 project.yml de coprofirst-ios) et les chemins de l'apple-app-site-association
                 des installations, SAUF les deux liens à jeton (/auth/verifier-email,
                 /auth/reinitialisation-mdp), laissés au navigateur. La vérification lit
                 /.well-known/assetlinks.json sur chaque hôte (coprofirst#2788). Un lien n'est
                 qu'une adresse : elle se découvre, puis se confirme (OrigineAdresse.Lien). -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" />
                <data android:host="demo.coprofirst.fr" />
                <data android:host="5hostachy.fr" />
                <data android:path="/" />
                <data android:path="/tickets" />
                <data android:pathPrefix="/tickets/" />
                <data android:path="/actualites" />
                <data android:pathPrefix="/actualites/" />
                <data android:path="/auth/connexion" />
            </intent-filter>
        </activity>

        <!-- Les pièces jointes ouvertes « en grand » (commun/pieces/Ouverture.kt) : copiées
             dans le CACHE de l'app (cache/pieces/, et rien d'autre — xml/chemins_pieces),
             confiées à l'app de l'appareil qui sait les montrer, avec le droit de lire CE
             fichier, le temps de l'ouverture (grantUriPermissions) ; non exporté. Aucune
             permission de plus. Confidentialité : une pièce ouverte reste sur l'appareil,
             en cache, jusqu'au prochain lancement ou à la déconnexion (effacée alors) ; le
             cache n'est jamais sauvegardé ni transféré. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.pieces"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/chemins_pieces" />
        </provider>
    </application>

</manifest>
